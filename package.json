{
  "name": "ditto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,less,scss,sass}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "postinstall": "echo 'please use npm run setup to finish the project configure' || true",
    "setup": "bash init-project.sh",
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode production",
    "dev:test": "vite --mode staging",
    "build:dev": "tsc && vite build --mode development",
    "build:prod": "tsc && vite build --mode production",
    "build:test": "tsc && vite build --mode staging",
    "preview": "vite preview",
    "configbot": "node configure.js"
  },
